# yureka2 (wt89536) - merge AFTER mi8953.config to override
#
# Touchscreen: yureka2 only uses goodix GT915L + focaltech FT5346.
# Other vendors' touch drivers are disabled here.

# goodix: keep the mainline 4.19 GT915L driver, drop the techpack gt9xx
# (their symbols collide - never enable both)
# CONFIG_TOUCHSCREEN_GT9XX is not set
CONFIG_TOUCHSCREEN_GT915L=y
CONFIG_TOUCHSCREEN_FT5346=y

# yureka2 has no TD4310 (E7 / LANSI E7) panels
# CONFIG_TOUCHSCREEN_TD4310_E7 is not set
# CONFIG_TOUCHSCREEN_TD4310_LANSI_E7 is not set

# yureka2 has no NT36XXX panels
# CONFIG_TOUCHSCREEN_NT36XXX is not set
# CONFIG_TOUCHSCREEN_NT36XXX_I2C is not set
# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set

# LED: ET6326 RGB (private yureka2 LED driver)
CONFIG_LEDS_ET6326=y

# NFC: NXP PN547 (private yureka2 NFC driver)
CONFIG_NFC_PN547=y

# Camera: yureka2 builds the markw stack only (no legacy stacks)
# CONFIG_MSMB_CAMERA_LEGACY is not set
# CONFIG_MSMB_CAMERA_LEGACY_N is not set
CONFIG_MSMB_CAMERA_V2_MARKW=y
